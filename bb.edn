{:paths ["scripts" "scripts/mdq" "test"]
 :deps {org.babashka/cli {:mvn/version "0.2.23"}
        instaparse/instaparse {:git/url "https://github.com/Engelberg/instaparse"
                               :git/sha "08a3580c9deab63727bfe11b1475d90d6147a3fe"}}
 :pods {org.babashka/fswatcher {:version "0.0.7"}}
 :tasks
 {:requires ([babashka.cli :as cli]
             assoc-exts
             bb-man
             config-save
             deps-clj-as-clojure
             java-version
             loc
             named-du
             bb-nrepl
             grok-bot-sync
             idea-inbox-backup
             skills-sync
             watch)

  loc {:doc "Count lines of code [path...] (excludes generated files, markdown, vendor)"
       :task (loc/count! *command-line-args*)}

  named-du {:doc "Disk usage for named dirs [name...] [--root DIR] [--limit N] [--edn] (default root ~/Projects)"
            :task (named-du/report! *command-line-args*)}

  assoc-exts {:doc "Promote an app for coding extensions [app] [exts] [--force] [--dry-run] [--list]"
              :task (assoc-exts/exec! *command-line-args*)}

  bb {:doc "Manage bb binary [--download <ref> | --use <ref> | --unuse]"
      :task (bb-man/exec! (cli/parse-opts *command-line-args*
                                          bb-man/cli-spec))}

  clj {:doc "Manage clojure installs"
       :task (deps-clj-as-clojure/exec! (cli/parse-opts *command-line-args*
                                                        deps-clj-as-clojure/cli-spec))}

  config {:doc "Manage config repos"
          :task (config-save/exec! (cli/parse-opts *command-line-args*
                                                   config-save/cli-spec))}

  java {:doc "Manage Java versions"
        :task (java-version/exec! (cli/parse-opts *command-line-args*
                                                  java-version/cli-spec))}

  mdq {:doc "Query Markdown (jq for Markdown)"
       :requires ([mdq])
       :task (mdq/exec! *command-line-args*)}

  bb-nrepl {:doc "Start bb nREPL server [--port <n>]"
            :task (bb-nrepl/start! (cli/parse-opts *command-line-args*
                                                   bb-nrepl/cli-spec))}

  grok-bot-sync {:doc "Lean-sync Calva projects for Grok Bot [--dry-run] [--projects a,b]"
                 :task (grok-bot-sync/exec! *command-line-args*)}

  idea-inbox-backup {:doc "Apply Grok Bot idea-inbox.bundle into ~/Projects/idea-inbox [--dry-run]"
                     :task (idea-inbox-backup/exec! *command-line-args*)}

  skills-sync {:doc "Symlink ~/.agents/skills + ~/.cursor/skills into ~/.claude/skills [--dry-run]"
               :task (skills-sync/exec! *command-line-args*)}



  -bbg:test:e2e {:doc "Run E2E compatibility tests against Rust mdq specs"
                 :requires ([mdq-e2e-test])
                 :task (mdq-e2e-test/run-e2e!
                        (cli/parse-opts *command-line-args*
                                        mdq-e2e-test/cli-spec))}

  -bbg:test:unit {:doc "Run tests"
                  :task (do (require 'mdq-test :reload)
                            (let [{:keys [fail error]} (clojure.test/run-tests 'mdq-test)]
                              (System/exit (if (zero? (+ fail error)) 0 1))))}

  -bbg:watch:unit {:doc "Watch scripts/ and test/ and re-run unit tests on changes"
                   :task (watch/watch! "Unit Tests" "bb -bbg:test:unit"
                                       ["scripts" "test"]
                                       {:extensions [".clj"]})}

  -bbg:task-options {:requires ([mdq])
                     :task (let [task-specs {"assoc-exts" assoc-exts/cli-spec
                                             "bb"        bb-man/cli-spec
                                             "bb-nrepl"  bb-nrepl/cli-spec
                                             "clj"       deps-clj-as-clojure/cli-spec
                                             "config"    config-save/cli-spec
                                             "java"      java-version/cli-spec
                                             "mdq"       mdq/cli-spec
                                             "named-du"  named-du/cli-spec
                                             "grok-bot-sync" grok-bot-sync/cli-spec
                                             "idea-inbox-backup" idea-inbox-backup/cli-spec
                                             "skills-sync" skills-sync/cli-spec}]
                             (doseq [opt (-> (get task-specs (first *command-line-args*))
                                             :coerce keys)]
                               (println (str "--" (name opt)))))}

  -bbg:watch:e2e {:doc "Watch scripts/, test/, and test specs, re-run E2E tests on changes"
                  :task (watch/watch! "E2E Tests" "bb -bbg:test:e2e"
                                      ["scripts" "test" "dev/test-specs"]
                                      {:extensions [".clj" ".toml"]})}}}
